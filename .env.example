# Copie para .env (o .env fica fora do git).
# Na nuvem, estes mesmos nomes viram secrets do GitHub Actions.

# --- Fonte: email (caminho da nuvem, credencial que nao expira) ---
IMAP_USER=seu-email@gmail.com
IMAP_PASSWORD=                 # senha de app do Google, 16 letras

# --- Fonte: agenda (endereco secreto em formato iCal) ---
CALENDAR_ICS_URL=              # aceita varias URLs separadas por virgula

# --- Saida ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Opcionais ---
# LIFE_INBOX_HOME=/caminho/seguro   # padrao: ~/.life-inbox
# EMAIL_LOOKBACK_HOURS=24
# CALENDAR_LOOKAHEAD_HOURS=48
# LIFE_DEBUG=1                      # mostra traceback completo

# Usado pelo monitor de voos (src/), nao pelo Life Inbox
SERPAPI_KEY=
